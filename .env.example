# ==============================================================================
# AgriMind — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root: cp .env.example .env
# 2. Add your Google Gemini API key below (without quotes).
# 3. Never commit '.env' to version control (it is excluded by .gitignore).
#
# Note: AgriMind functions 100% offline using local PyTorch ResNet-50 for vision
# and local grounded extractive synthesis for RAG. Configuring this key enables
# optional LLM-synthesized RAG answers via Gemini.
# ==============================================================================

# Google Gemini API Key (for RAG Answer Synthesis)
GEMINI_API_KEY=

# Optional alternative credential variable:
# GOOGLE_API_KEY=

# Optional Gemini model selection (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash
